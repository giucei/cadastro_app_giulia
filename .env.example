# Arquivo .env (NÃO COMMITAR)
# ATENÇÃO: Este arquivo não deve conter credenciais publicadas no GitHub.
# Substitua os placeholders abaixo pelos seus valores do MongoDB Atlas e da API.

# String de conexão do MongoDB Atlas (use a sua, não compartilhe)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# Nome do banco (opcional)
DB_NAME=ifood_app

# Se usar uma Data API alternativa
API_URL="https://sua-url-do-mongo-data-api"
API_KEY="sua-apikey-aqui"

# Porta local (opcional)
PORT=3000

# NOTA: Se você acidentalmente comitou credenciais para o repositório,
# remova-as do histórico e gere novas chaves/usuários no Atlas imediatamente.
